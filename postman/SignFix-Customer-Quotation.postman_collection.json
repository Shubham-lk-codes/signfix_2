{
  "info": {
    "_postman_id": "75143d9a-b1dc-45f1-bf21-signfixquote",
    "name": "SignFix - Customer Quotation APIs",
    "description": "Production customer quotation API tests with optional admin setup. Run Optional Admin Setup first when you do not already have a SENT/VIEWED quotation. In the Customer Decisions folder, run only ONE decision against a quotation; use a new revision or another quotation for the other decisions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://signfix-2.onrender.com", "type": "string" },
    { "key": "customerEmail", "value": "customer@signfix.in", "type": "string" },
    { "key": "customerPassword", "value": "SignFix@123", "type": "string" },
    { "key": "adminEmail", "value": "admin@signfix.in", "type": "string" },
    { "key": "adminPassword", "value": "SignFix@123", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "orderNo", "value": "", "type": "string" },
    { "key": "quotationNo", "value": "SB-QUO-2026-000001", "type": "string" },
    { "key": "lockVersion", "value": "1", "type": "string" },
    { "key": "validUntil", "value": "2026-10-08", "type": "string" },
    { "key": "decisionToTest", "value": "request_changes", "type": "string" },
    { "key": "runLegacy", "value": "false", "type": "string" }
  ],
  "item": [
    {
      "name": "0 - Optional Admin Setup",
      "description": "Creates and sends a real quotation for an existing order. Skip this folder when quotationNo already points to a customer-owned SENT/VIEWED quotation.",
      "item": [
        {
          "name": "Admin Login",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"portal\": \"admin\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Admin login succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "if (body.token) pm.collectionVariables.set('adminToken', body.token);"] } }]
        },
        {
          "name": "Find Existing Order",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
          "request": { "method": "GET", "url": "{{baseUrl}}/api/quotations/options" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Options load', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "const customerEmail = String(pm.collectionVariables.get('customerEmail')).toLowerCase();", "const order = (body.orders || []).find(item => String(item.email || '').toLowerCase() === customerEmail);", "if (order) pm.collectionVariables.set('orderNo', order.orderNo);", "pm.test('Eligible order exists for the test customer', () => pm.expect(order, 'Create an order for customerEmail before setup').to.exist);"] } }]
        },
        {
          "name": "Create Draft Quotation",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const date = new Date();", "date.setUTCDate(date.getUTCDate() + 30);", "pm.collectionVariables.set('validUntil', date.toISOString().slice(0, 10));"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Draft created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "if (body.quotationNo) pm.collectionVariables.set('quotationNo', body.quotationNo);", "if (body.lockVersion) pm.collectionVariables.set('lockVersion', String(body.lockVersion));", "pm.test('Server generated official number', () => pm.expect(body.quotationNo).to.match(/^SB-QUO-\\d{4}-\\d{6}$/));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderNo\": \"{{orderNo}}\",\n  \"validUntil\": \"{{validUntil}}\",\n  \"items\": [\n    {\n      \"description\": \"ACP LED sign board - 8 ft x 4 ft\",\n      \"quantity\": 32,\n      \"unit\": \"sqft\",\n      \"unitPrice\": 850,\n      \"discountType\": \"percentage\",\n      \"discountValue\": 5,\n      \"taxPercentage\": 18,\n      \"metadata\": { \"material\": \"ACP\", \"lighting\": \"LED\" }\n    },\n    {\n      \"description\": \"Installation and mounting\",\n      \"quantity\": 1,\n      \"unit\": \"job\",\n      \"unitPrice\": 4500,\n      \"discountType\": \"none\",\n      \"discountValue\": 0,\n      \"taxPercentage\": 18\n    }\n  ],\n  \"installation\": 1500,\n  \"transportation\": 750,\n  \"design\": 500,\n  \"accessories\": 300,\n  \"otherCharges\": 0,\n  \"discountType\": \"fixed\",\n  \"discountValue\": 1000,\n  \"gstPercentage\": 18,\n  \"terms\": \"50% advance with order confirmation. Balance before installation.\",\n  \"customerNotes\": \"Installation subject to site readiness.\",\n  \"internalNotes\": \"Internal margin note - customer must never receive this.\",\n  \"subtotal\": 1,\n  \"gstAmount\": 0,\n  \"finalAmount\": 1\n}" },
            "url": "{{baseUrl}}/api/quotations"
          }
        },
        {
          "name": "Send Quotation to Customer",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"expectedLockVersion\": {{lockVersion}},\n  \"internalNote\": \"Sent from the Postman setup flow\"\n}" },
            "url": "{{baseUrl}}/api/quotations/{{quotationNo}}/send"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Quotation sent', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "if (body.lockVersion) pm.collectionVariables.set('lockVersion', String(body.lockVersion));", "pm.test('State is SENT', () => pm.expect(body.status).to.eql('sent'));"] } }]
        }
      ]
    },
    {
      "name": "1 - Customer Authentication",
      "item": [
        {
          "name": "Customer Login",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"portal\": \"customer\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Customer login succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "if (body.token) pm.collectionVariables.set('customerToken', body.token);", "pm.test('Customer role returned', () => pm.expect(body.user.role).to.eql('customer'));"] } }]
        }
      ]
    },
    {
      "name": "2 - Customer Quotation Read APIs",
      "item": [
        {
          "name": "List Own Quotations",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customer/quotations?page=1&pageSize=20" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Owned list returned', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('Paginated shape', () => { pm.expect(body.data).to.be.an('array'); pm.expect(body.page).to.eql(1); });", "const actionable = (body.data || []).find(q => ['sent', 'viewed'].includes(q.status));", "if (actionable) pm.collectionVariables.set('quotationNo', actionable.quotationNo);"] } }]
        },
        {
          "name": "List Own Quotations - Status Filter",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customer/quotations?page=1&pageSize=10&status=sent" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Filtered list returned', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('Every result is SENT', () => (body.data || []).forEach(q => pm.expect(q.status).to.eql('sent')));"] } }]
        },
        {
          "name": "Get Own Quotation Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customer/quotations/{{quotationNo}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Detail returned', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('Safe customer DTO', () => { pm.expect(body.quotationNo).to.eql(pm.collectionVariables.get('quotationNo')); pm.expect(body.items).to.be.an('array'); pm.expect(body).not.to.have.property('internalNotes'); pm.expect(body).not.to.have.property('auditTrail'); });"] } }]
        },
        {
          "name": "Download Own Quotation PDF",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customer/quotations/{{quotationNo}}/pdf" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('PDF downloaded', () => pm.response.to.have.status(200));", "pm.test('PDF content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"] } }]
        }
      ]
    },
    {
      "name": "3 - Customer Decisions (Run Only One)",
      "description": "Approve, request changes and reject are mutually exclusive state transitions. Run one request per SENT/VIEWED quotation. Create/send a revision or another quotation before testing another outcome.",
      "item": [
        {
          "name": "Approve Own Quotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Approved. Please proceed with production planning.\"\n}" },
            "url": "{{baseUrl}}/api/customer/quotations/{{quotationNo}}/approve"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('decisionToTest') !== 'approve') pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Quotation approved', () => pm.response.to.have.status(200));", "pm.test('Approved state', () => pm.expect(pm.response.json().status).to.eql('approved'));"] } }
          ]
        },
        {
          "name": "Request Quotation Changes",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Please change the sign size to 10 ft x 4 ft and revise the installation charge.\"\n}" },
            "url": "{{baseUrl}}/api/customer/quotations/{{quotationNo}}/request-changes"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('decisionToTest') !== 'request_changes') pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Change requested', () => pm.response.to.have.status(200));", "pm.test('Change-requested state', () => pm.expect(pm.response.json().status).to.eql('change_requested'));"] } }
          ]
        },
        {
          "name": "Reject Own Quotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"The commercial amount is outside our approved budget.\"\n}" },
            "url": "{{baseUrl}}/api/customer/quotations/{{quotationNo}}/reject"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('decisionToTest') !== 'reject') pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Quotation rejected', () => pm.response.to.have.status(200));", "pm.test('Rejected state', () => pm.expect(pm.response.json().status).to.eql('rejected'));"] } }
          ]
        }
      ]
    },
    {
      "name": "4 - Legacy Compatibility",
      "description": "Kept only so the existing customer frontend continues to work. New integrations should use the explicit approve/request-changes/reject endpoints.",
      "item": [
        {
          "name": "Legacy Request Changes Action",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"request_changes\",\n  \"notes\": \"Please revise delivery and installation terms.\"\n}" },
            "url": "{{baseUrl}}/api/customer/quotations/{{quotationNo}}/action"
          },
          "event": [{ "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('runLegacy') !== 'true') pm.execution.skipRequest();"] } }]
        }
      ]
    },
    {
      "name": "5 - Security Checks",
      "item": [
        {
          "name": "List Without Token - Expect 401",
          "auth": { "type": "noauth" },
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customer/quotations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Authentication is required', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Unknown or Foreign Quotation - Expect 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customer/quotations/SB-QUO-2099-999999" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Ownership-safe not found', () => pm.response.to.have.status(404));"] } }]
        }
      ]
    }
  ]
}
