NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
# Copy the pooled connection string from Neon: Project > Connect > Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_POOL_SIZE=10
CORS_ORIGIN=http://localhost:5173,https://signfix-2.vercel.app
VITE_API_URL=
# Firebase Cloud Messaging (web client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Firebase Admin service account (server; keep private)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
APP_URL=http://localhost:5173
