NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=signfix-api
JWT_AUDIENCE=signfix-web
# Copy the pooled connection string from Neon: Project > Connect > Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
DB_POOL_SIZE=10
CORS_ORIGIN=http://localhost:5173,https://signfix-2.vercel.app
VITE_API_URL=
# Firebase Cloud Messaging (web client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Firebase Admin service account (server; keep private)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
APP_URL=http://localhost:5173
# AI platform (server-only secrets)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_IMAGE_MODEL=gpt-image-2
REDIS_URL=redis://localhost:6379
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_WORKER_ENABLED=false
# Notification channel providers (all optional except Firebase push)
RESEND_API_KEY=
EMAIL_FROM=SignFix <notifications@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Service-area validation tokens and Meta WhatsApp Cloud API
SERVICE_AREA_TOKEN_MINUTES=30
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
